<div class="container mt-5" style="max-width: 600px;">
  <h1>Stupid Coaching</h1>

  <blockquote class="p-3 bg-white border-start border-4 border-secondary-subtle">
    <p class="mb-1"><%= @user_question %></p>
    <footer class="blockquote-footer mt-1"><em>You</em></footer>
  </blockquote>


  <blockquote class="p-3 border-start border-4 border-secondary-subtle coach-reply">
    <p class="mb-1"><strong><%= @coach_answer %></strong></p>
    <footer class="blockquote-footer mt-1"><em>Your coach</em></footer>
  </blockquote>

  <br>
  <%= link_to "Ask a new question", ask_path, class: "text-decoration-none" %>
</div>
